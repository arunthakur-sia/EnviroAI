# SiaNexus local environment. Copy to .env.local and fill in what you have.
# Every key is optional: without ANTHROPIC_API_KEY the app runs in AI Mock Mode,
# without VOYAGE_API_KEY embeddings fall back to a local model.

# Anthropic API key for Ask NPC, enrichment, translation, briefs, scanning,
# podcast scripts, and report narratives.
ANTHROPIC_API_KEY=

# Optional override of the default answer model (Settings > AI also controls this).
ANTHROPIC_MODEL=claude-sonnet-4-6

# Voyage AI key for multilingual embeddings (voyage-multilingual-2).
VOYAGE_API_KEY=

# CR02: ElevenLabs key for studio podcast audio (eleven_multilingual_v2).
# Without it, episodes play through the browser's own voices ("Browser voice")
# and "Regenerate with studio voice" appears once a key exists.
ELEVENLABS_API_KEY=

# CR02: optional fixed voice ids for the two podcast hosts. When unset, two
# library voices (one female for Dr. Mariam, one male for Hamad) are picked at
# the first render, stored in Settings, and logged.
ELEVENLABS_VOICE_MARIAM=
ELEVENLABS_VOICE_HAMAD=

# CR02: optional Whisper upgrade for Add Knowledge's Speak mode
# (gpt-4o-transcribe, fallback whisper-1; best Arabic and mixed-language
# results). Without it the browser's speech recognition transcribes live.
OPENAI_API_KEY=

# Secret used to sign the session cookie. Auto-generated into
# ${DATA_DIR}/session-secret.txt on first run if absent; set it here to pin it.
# Must be at least 32 characters. On a deployment, set it: a generated one lives
# on the volume and a wiped volume would sign everyone out.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# Deployment. None of these is needed locally; the defaults are the local ones.
# ---------------------------------------------------------------------------

# Every runtime file (the database, uploads, reports, podcast audio, the session
# secret) lives here. Defaults to ./data. On Railway this is the volume's mount
# path, /app/data.
DATA_DIR=

# The public origin, with no trailing slash, e.g. https://sianexus.up.railway.app
# Used for links that leave the browser session. Unset locally, where the
# browser composes them from its own origin.
APP_URL=

# The session cookie is Secure whenever NODE_ENV=production. Set this to 0 to
# force it off (a production build served over plain http, as `npm run
# start:demo` does locally) or to 1 to force it on.
SESSION_COOKIE_SECURE=

# Scheduled signal scanning is off unless this is exactly "true". "Refresh
# signals" in Trends always works, whatever this says.
SCAN_SCHEDULE_ENABLED=false

# Week boundaries (Knowledge of the Week, leaderboard periods) follow the
# process time zone. Asia/Qatar on a deployment; unset locally.
TZ=

# Only when there is no data bundle: seed from the committed sources on the
# first start if the database has no users. Needs development dependencies.
SEED_ON_EMPTY=false
