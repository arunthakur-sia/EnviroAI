# NEXUS local environment. Copy to .env.local and fill in what you have.
# Every key is optional: without ANTHROPIC_API_KEY the app runs in AI Mock Mode,
# without VOYAGE_API_KEY embeddings fall back to a local model.

# Anthropic API key for Ask NEXUS, enrichment, translation, briefs.
ANTHROPIC_API_KEY=

# Optional override of the default answer model (Settings > AI also controls this).
ANTHROPIC_MODEL=claude-sonnet-4-6

# Voyage AI key for multilingual embeddings (voyage-multilingual-2).
VOYAGE_API_KEY=

# Secret used to sign the session cookie. Auto-generated into data/session-secret.txt
# on first run if absent; set it here to pin it.
SESSION_SECRET=
