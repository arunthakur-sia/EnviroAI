  "//optionalDependencies": "The Linux x64 glibc binaries this tree needs, pinned to the versions the lockfile already resolved. They are optional so Windows skips them and Linux installs them, and they are declared here rather than left to each parent package so a production install that omits dev dependencies still gets the ones whose parent is a dev dependency. Nothing musl is listed: the deployment image is glibc. See DECISIONS 138.",
  "optionalDependencies": {
    "@img/sharp-libvips-linux-x64": "1.3.3",
    "@img/sharp-linux-x64": "0.35.4",
    "@libsql/linux-x64-gnu": "0.5.29",
    "@napi-rs/canvas-linux-x64-gnu": "0.1.100",
    "@next/swc-linux-x64-gnu": "15.5.25",
    "@parcel/watcher-linux-x64-glibc": "2.6.0",
    "@swc/core-linux-x64-gnu": "1.16.2",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@unrs/resolver-binding-linux-x64-gnu": "1.12.2",
    "lightningcss-linux-x64-gnu": "1.32.0"
  },
  "//devDependencies": "The two wasm32-wasi shims this laptop needs are deliberately absent: they declare cpu wasm32, so npm refuses them on x64 and the deployment build died on EBADPLATFORM. `npm run setup:win` installs them with --no-save, which keeps them out of this file and out of the lockfile. See DECISIONS 138.",
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.5",
    "@next/swc-wasm-nodejs": "^15.5.25",
    "drizzle-kit": "^0.31.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.0",
    "playwright": "^1.48.0",
    "ts-prune": "^0.10.3",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  }
